# Public Firebase web configuration for vybecheck-6a8b7. These are not Admin credentials.
VITE_FIREBASE_API_KEY=AIzaSyA60N6tpLTMlaaX9sYm9wGfpj0h5LQVcBs
VITE_FIREBASE_AUTH_DOMAIN=vybecheck-6a8b7.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vybecheck-6a8b7
VITE_FIREBASE_STORAGE_BUCKET=vybecheck-6a8b7.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=175960831558
VITE_FIREBASE_APP_ID=1:175960831558:web:fa6c7e266184f4996fbc47
VITE_FIREBASE_MEASUREMENT_ID=G-BWX9MBN2W3

# Server-side Firebase Admin. Keep the project ID aligned with the web config.
FIREBASE_PROJECT_ID=vybecheck-6a8b7
FIREBASE_STORAGE_BUCKET=vybecheck-6a8b7.firebasestorage.app

# Local/Vercel server only. Firebase Functions uses its managed credentials.
# On Vercel, set FIREBASE_SERVICE_ACCOUNT_JSON to the full service-account JSON
# in Project Settings → Environment Variables, then redeploy. Never use a VITE_ prefix.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional server integrations. Set these in your host's secret manager to enable them.
PAYSTACK_SECRET_KEY=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=
ACR_HOST=identify-eu-west-1.acrcloud.com

# Optional override; defaults to VITE_FIREBASE_MEASUREMENT_ID.
VITE_GA_MEASUREMENT_ID=

# Only needed when importing existing data from Supabase.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# For local emulators only (set all three together with VITE_USE_FIREBASE_EMULATORS).
# VITE_USE_FIREBASE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
